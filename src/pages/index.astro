---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <div
        class="w-full min-h-screen text-light-text bg-light-bg dark:text-dark-text dark:bg-dark-bg flex flex-col justify-center items-center"
    >
        <h1 class="text-9xl">&Yopf;</h1>
        <div class="w-96 mt-8 text-slate-600 dark:text-slate-400">
            <p>
                Y is a social media platform where users can share short
                messages, follow others, and engage in conversations. It offers
                a seamless experience for staying connected with friends and
                discovering trending topics.
            </p>
            <p class="text-center mt-8">
                Get started by <a
                    class="hover:underline text-blue-600"
                    href="/sign-up">signing up</a
                >!
            </p>
        </div>
    </div>
</Layout>
